# Copie este arquivo para .env e informe as configurações do ambiente local.
DB_HOST=mysql
DB_PORT=3306
DB_NAME=loja
DB_USER=loja
DB_PASS=loja

# Segredo JWT de desenvolvimento; use um valor aleatório com pelo menos 32 caracteres.
JWT_SECRET=replace-this-with-a-random-secret-of-at-least-32-chars
JWT_TTL=7200
