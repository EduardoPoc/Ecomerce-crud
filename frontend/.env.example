# Copie este arquivo para .env dentro de frontend/ quando rodar o Vite fora do Docker.
# Em desenvolvimento, o frontend chama a API pela rota same-origin /api do Vite.
# O Docker Compose encaminha /api para http://php:80 pela rede interna.
# Fora do Docker, ajuste VITE_API_PROXY_TARGET para um endpoint HTTP da API que não redirecione.
# Variáveis VITE_ ficam visíveis no navegador: não coloque senhas, tokens privados ou chaves secretas aqui.
VITE_API_URL=/api
VITE_API_PROXY_TARGET=http://localhost:8080
