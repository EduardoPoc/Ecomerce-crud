# Copie este arquivo para .env dentro de frontend/ quando for integrar a API.
# Informe a URL base real do backend, por exemplo: http://localhost:3000/api
# No JavaScript, leia com import.meta.env.VITE_API_BASE_URL.
# Variáveis VITE_ ficam visíveis no navegador: não coloque senhas, tokens privados ou chaves secretas aqui.
VITE_API_BASE_URL=8000
